# LLM Benchmarking Framework — Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control

# ─── API Keys ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=        # For Meta Llama models

# ─── Optional / Advanced ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434   # For local Ollama
VLLM_BASE_URL=http://localhost:8000      # For local vLLM

# LLM-as-a-Judge model (defaults to gpt-4o-mini for cost efficiency)
JUDGE_MODEL=gpt-4o-mini
JUDGE_PROVIDER=openai

# Benchmark settings
LOG_LEVEL=INFO
MAX_WORKERS=10          # Parallel benchmark workers
DRY_RUN=false           # If true, skip actual API calls
